# Vercel forwards /api to http://115.68.223.74:8000/api on this server.
# Bind to all host interfaces so Vercel can reach the backend. The Compose
# default is 127.0.0.1 for deployments using a proxy on the same host.
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=https://your-frontend.vercel.app
APP_ACCESS_TOKEN=replace-with-a-long-random-personal-key
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional direct HTTPS: set a domain and enable the https Compose profile.
# This starts Caddy on ports 80/443; leave the profile off for the Vercel proxy.
# API_HOST=api.example.com
